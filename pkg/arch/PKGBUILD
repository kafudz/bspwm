# Maintainer: kafudz <kafudzsocial@gmail.com>

_pkgname=bspwm
pkgname=bspwm-kafudz-git
pkgver=1.7.5
pkgrel=1
pkgdesc="Tiling window manager based on binary space partitioning (kafudz git version)"
arch=('x86_64')
url="https://github.com/kafudz/bspwm"
license=('BSD-2-Clause')
depends=('libxcb' 'xcb-util' 'xcb-util-keysyms' 'xcb-util-wm' 'libxkbcommon')
makedepends=('git')
optdepends=('sxhkd: keybinding daemon')
provides=("${_pkgname}=${pkgver%%.r*}")
conflicts=("${_pkgname}")
source=("${_pkgname}::git+${url}.git#branch=master")
sha256sums=('SKIP')

pkgver() {
	cd "${srcdir}/${_pkgname}"
	# `git describe | sed` exits 0 even when there is no usable tag, so the
	# old `|| printf` fallback never ran and pkgver() printed nothing, which
	# makes makepkg abort with "pkgver is not allowed to be empty".
	ver=$(git describe --long --tags --abbrev=7 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g')
	if [[ -z $ver ]]; then
		printf '0.0.0.r%s.g%s\n' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
	else
		printf '%s\n' "$ver"
	fi
}

build() {
	cd "${srcdir}/${_pkgname}"
	make
}

check() {
	cd "${srcdir}/${_pkgname}"
	make -C tests test_rule_match test_magnet test_jsmn test_geometry test_parse
	for test in test_rule_match test_magnet test_jsmn test_geometry test_parse; do
		"tests/$test"
	done
}

package() {
	cd "${srcdir}/${_pkgname}"
	make DESTDIR="${pkgdir}" PREFIX=/usr install
}
